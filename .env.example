# Discord bot token from the Discord Developer Portal.
DISCORD_TOKEN=your-bot-token-here

# Path to the SQLite database file (created automatically if missing).
DATABASE_PATH=osrs-challenge.db

# Optional: a guild ID for instant slash-command registration during development.
# Without this, global commands are registered instead, which can take up to an hour
# to propagate on Discord's side.
DEV_GUILD_ID=
